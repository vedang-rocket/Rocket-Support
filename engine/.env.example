# engine/.env — secrets for the rkt-diagnose engine
#
# Copy this file to engine/.env and fill in the values:
#   cp engine/.env.example engine/.env
#
# engine/.env is gitignored — never commit real keys.

# Anthropic API key — used by claude_agent.py PATH B.
