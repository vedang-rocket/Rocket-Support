#!/usr/bin/env bash
# ============================================================
#  rkt-diagnose <threadId> [hint] [--shadow]
#
#  SSH init (identical to rkt-ok) PLUS full engine diagnosis
#  and automatic fix application.
#
#  Usage:
#    rkt-diagnose DC-MAY-12
#    rkt-diagnose DC-MAY-12 "user cannot login"
#    rkt-diagnose DC-MAY-12 --shadow          # dry-run, no changes
#    rkt-diagnose DC-MAY-12 "hint" --shadow
# ============================================================

THREAD_ID=""
HINT=""
SHADOW="false"

for arg in "$@"; do
  case "$arg" in
    --shadow) SHADOW="true" ;;
    *)
      if [[ -z "$THREAD_ID" ]]; then
        THREAD_ID="$arg"
      elif [[ -z "$HINT" ]]; then
        HINT="$arg"
      fi
      ;;
  esac
done

SSH_HOST="support-vedang-patel"
REMOTE_APP_DIR="/home/ubuntu/app"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENGINE_DIR="$SCRIPT_DIR/../engine"
VENV_PYTHON="$ENGINE_DIR/.venv/bin/python"
LOCAL_TMP="/tmp/rkt-diagnose-$THREAD_ID"
RESULT_FILE="$LOCAL_TMP/.rkt_result.json"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RED='\033[0;31m'; NC='\033[0m'
info() { echo -e "  ${CYAN}▸${NC}  $1"; }
fail() { echo -e "  ${RED}✗${NC}  $1" >&2; exit 1; }

# ── Usage ─────────────────────────────────────────────────────────────────────
if [[ -z "$THREAD_ID" ]]; then
  echo ""
  echo -e "  ${BOLD}Usage:${NC}    rkt-diagnose <threadId> [hint] [--shadow]"
  echo -e "  ${BOLD}Examples:${NC} rkt-diagnose DC-MAY-12"
  echo -e "            rkt-diagnose DC-MAY-12 \"user cannot login\""
  echo -e "            rkt-diagnose DC-MAY-12 --shadow"
  echo ""
  exit 1
fi

# ── Verify engine venv ────────────────────────────────────────────────────────
if [[ ! -x "$VENV_PYTHON" ]]; then
  fail "Engine venv not found: $VENV_PYTHON"
fi

echo ""
if [[ "$SHADOW" == "true" ]]; then
  echo -e "  ${YELLOW}⚠  SHADOW MODE — diagnosis only, no files will be modified${NC}"
  echo ""
fi

# ── [1/4] SSH init ────────────────────────────────────────────────────────────
printf "  \033[1;36m[1/4]\033[0m \033[1minitialising project...\033[0m"

# Step 1a: Clean any existing project
TERM=xterm-256color ssh "$SSH_HOST" "echo 'y' | rocket clean 2>&1" >/dev/null 2>&1 || true

# Step 1b: rocket init
INIT_OUTPUT=$(TERM=xterm-256color ssh "$SSH_HOST" "printf '1\ny\n' | rocket init $THREAD_ID 2>&1")
if ! echo "$INIT_OUTPUT" | grep -q '"code":"OK"'; then
  printf "\n"
  fail "rocket init failed — check thread ID: $THREAD_ID"
fi

# Step 1c: Detect project folder
PROJECT_FOLDER=$(TERM=xterm-256color ssh "$SSH_HOST" "ls -t $REMOTE_APP_DIR 2>/dev/null | head -1")
if [[ -z "$PROJECT_FOLDER" ]]; then
  printf "\n"
  fail "Could not detect project folder in ~/app"
fi
REMOTE_PROJECT_PATH="$REMOTE_APP_DIR/$PROJECT_FOLDER"

# Step 1d: Install cursor rules (silent)
"$SCRIPT_DIR/rkt-rules-add" >/dev/null 2>&1 || true

printf "  \033[0;32m✓\033[0m  ${PROJECT_FOLDER}\n"

# ── rsync remote → local temp ─────────────────────────────────────────────────
mkdir -p "$LOCAL_TMP"

rsync -az --quiet \
  --exclude 'node_modules' --exclude '.next' --exclude '.git' \
  --exclude 'dist' --exclude '.turbo' --exclude '*.log' \
  "$SSH_HOST:$REMOTE_PROJECT_PATH/" "$LOCAL_TMP/" 2>/dev/null

if [[ -z "$(ls -A "$LOCAL_TMP" 2>/dev/null)" ]]; then
  fail "rsync failed — $LOCAL_TMP is empty"
fi

# ── [2/4]–[4/4]: Python engine ────────────────────────────────────────────────
SHADOW_FLAG=""
[[ "$SHADOW" == "true" ]] && SHADOW_FLAG="--shadow"

"$VENV_PYTHON" "$ENGINE_DIR/diagnose_output.py" \
  --repo-path    "$LOCAL_TMP" \
  --hint         "$HINT" \
  --thread       "$THREAD_ID" \
  --project-name "$PROJECT_FOLDER" \
  --out-file     "$RESULT_FILE" \
  $SHADOW_FLAG

PYTHON_EXIT=$?

# ── rsync fixes back (only if fixes were applied, not shadow) ─────────────────
if [[ "$SHADOW" != "true" && "$PYTHON_EXIT" -eq 0 && -f "$RESULT_FILE" ]]; then
  FIXES_APPLIED=$("$VENV_PYTHON" -c \
    "import json,sys; d=json.load(open(sys.argv[1])); print(d.get('fixes_applied',False))" \
    "$RESULT_FILE" 2>/dev/null || echo "False")

  if [[ "$FIXES_APPLIED" == "True" ]]; then
    rm -f "$RESULT_FILE"   # delete before rsync so it never lands in the project
    rsync -az --quiet \
      --exclude 'node_modules' --exclude '.next' --exclude '.git' \
      --exclude 'dist' --exclude '.turbo' --exclude '*.log' \
      --exclude '.rkt_result.json' --exclude '*.rkt_backup' \
      "$LOCAL_TMP/" "$SSH_HOST:$REMOTE_PROJECT_PATH/" 2>/dev/null
  fi
fi

# ── npm install in container before opening Cursor ───────────────────────────
TERM=xterm-256color ssh "$SSH_HOST" \
  "cd \"$REMOTE_PROJECT_PATH\" && npm install --prefer-offline --quiet 2>&1" \
  >/dev/null 2>&1 || true

# ── Ask before opening Cursor ────────────────────────────────────────────────
echo ""
printf "  \033[1mOpen in Cursor?\033[0m  [Enter to open · Ctrl+C to skip] "
read -r _CURSOR_REPLY 2>/dev/null || true
cursor --remote "ssh-remote+$SSH_HOST" "$REMOTE_PROJECT_PATH" &>/dev/null &

# ── Cleanup ───────────────────────────────────────────────────────────────────
rm -f "$RESULT_FILE"
# Keep LOCAL_TMP — engineer may want to inspect or re-run

echo ""
echo -e "  When done:  ${CYAN}rkt-done${NC}"
echo ""

exit "$PYTHON_EXIT"
