#!/usr/bin/env bash
# ============================================================
#  rkt-rules-remove
#  Removes cursor-rules-v34 files from the active remote project
#  Usage: rkt-rules-remove [--yes]
#    --yes  skip confirmation prompt (used by rkt-done)
# ============================================================

SSH_HOST="support-vedang-patel"
REMOTE_APP_DIR="/home/ubuntu/app"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; RED='\033[0;31m'; NC='\033[0m'
ok()   { echo -e "  ${GREEN}✓${NC}  $1"; }
info() { echo -e "  ${CYAN}▸${NC}  $1"; }
warn() { echo -e "  ${YELLOW}⚠${NC}  $1"; }
fail() { echo -e "  ${RED}✗${NC}  $1"; exit 1; }

AUTO_YES=false
[[ "${1:-}" == "--yes" ]] && AUTO_YES=true

echo ""
echo -e "${BOLD}${CYAN}── rkt-rules-remove ──────────────────────────────────────${NC}"
echo ""

# ── Detect active project ─────────────────────────────────────
info "Detecting active project on ${BOLD}$SSH_HOST${NC}..."
PROJECT_FOLDER=$(TERM=xterm-256color ssh "$SSH_HOST" "ls -t $REMOTE_APP_DIR 2>/dev/null | head -1")

if [[ -z "$PROJECT_FOLDER" ]]; then
  fail "No active project found in $REMOTE_APP_DIR on $SSH_HOST"
fi

REMOTE_PROJECT_PATH="$REMOTE_APP_DIR/$PROJECT_FOLDER"
ok "Active project: ${BOLD}$PROJECT_FOLDER${NC}"
echo ""

# ── Confirm ───────────────────────────────────────────────────
if [[ "$AUTO_YES" == false ]]; then
  echo -e "  ${BOLD}Will remove from${NC} $REMOTE_PROJECT_PATH${BOLD}:${NC}"
  echo -e "    .cursor/  agents/  contexts/"
  echo -e "    AGENTS.md  the-rocket-guide.md  TROUBLESHOOTING.md  cursor.config  components.json"
  echo ""
  echo -ne "  ${BOLD}Remove cursor rules? [y/N]:${NC} "
  read -r CONFIRM
  if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    info "Cancelled."
    exit 0
  fi
  echo ""
fi

# ── Remove files ──────────────────────────────────────────────
info "Removing .cursor/ and companion files..."
TERM=xterm-256color ssh "$SSH_HOST" "
  cd '$REMOTE_PROJECT_PATH' || exit 1
  rm -rf .cursor/ agents/ contexts/
  rm -f AGENTS.md the-rocket-guide.md TROUBLESHOOTING.md cursor.config components.json
"

if [[ $? -eq 0 ]]; then
  ok ".cursor/ removed"
  ok "agents/ removed"
  ok "contexts/ removed"
  ok "Root files removed (AGENTS.md, the-rocket-guide.md, TROUBLESHOOTING.md, cursor.config, components.json)"
else
  fail "ssh removal command failed"
fi

# ── Clean .gitignore ──────────────────────────────────────────
info "Cleaning .gitignore..."
TERM=xterm-256color ssh "$SSH_HOST" "
  cd '$REMOTE_PROJECT_PATH' || exit 1
  if [[ -f .gitignore ]] && grep -qF '# rkt-rules (local dev only)' .gitignore; then
    perl -i -0pe 's/\n# rkt-rules \(local dev only\)\n\.cursor\/\nagents\/\ncontexts\/\nAGENTS\.md\nthe-rocket-guide\.md\nTROUBLESHOOTING\.md\ncursor\.config\ncomponents\.json//s' .gitignore
  fi
"
ok ".gitignore cleaned"

echo ""
echo -e "${BOLD}${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BOLD}  Cursor rules removed from $REMOTE_PROJECT_PATH${NC}"
echo -e "${BOLD}${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
